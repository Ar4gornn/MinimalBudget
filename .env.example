# Copy to .env and fill in. .env is git-ignored and must never be committed.
# No value here is a working default — the API refuses to start without the real ones.

# --- Postgres container bootstrap (used by docker compose only) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_DB=minimalbudget

# --- Schema owner: owns the tables, runs migrations. The API never uses this. ---
DB_OWNER=minimalbudget_owner
DB_OWNER_PASSWORD=

# --- Runtime role: DML only, no DDL, no BYPASSRLS. This is what the API connects as. ---
DB_APP_USER=minimalbudget_app
DB_APP_PASSWORD=

# --- Connection strings ---
# The API reads DATABASE_URL. Alembic reads MIGRATION_DATABASE_URL.
DATABASE_URL=postgresql+psycopg://minimalbudget_app:CHANGE_ME@localhost:5432/minimalbudget
MIGRATION_DATABASE_URL=postgresql+psycopg://minimalbudget_owner:CHANGE_ME@localhost:5432/minimalbudget

# --- Registration ---
# invite = only someone holding a code from `python backend/invite.py new` can register.
# open   = anyone who can reach the URL can create an account.
# Unset means invite. Do not set this to open on an internet-facing instance.
REGISTRATION_MODE=invite

# --- Login rate limiting ---
# Failed attempts per email AND per source address before a lockout, and how long it lasts.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# --- Auth ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# --- CORS: comma-separated origins allowed to call the API ---
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
# Empty means same-origin, which is what the Vite dev server's /api proxy provides.
# Set this to the API's origin for a production build; the backend's CORS_ORIGINS must
# then list the origin the client is served from.
VITE_API_BASE_URL=

# --- Push notifications (optional; all three empty means push is off) ---
# Generate the pair with:  cd backend && python vapid.py
# VAPID_SUBJECT must be a real address a push service can reach about this application.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Production only (docker-compose.prod.yml) ---
# The domain pointed at this machine. Caddy obtains and renews its certificate for it
# automatically; nothing else about TLS needs configuring.
DOMAIN=budget.example.com
# Where Let's Encrypt sends expiry warnings. Required — the certificate directive will not
# parse without it.
ACME_EMAIL=you@example.com
