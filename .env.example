# Copy to .env and fill in. .env is git-ignored and must never be committed.
# No value here is a working default — the API refuses to start without the real ones.

# --- Postgres container bootstrap (used by docker compose only) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_DB=moneymap

# --- Schema owner: owns the tables, runs migrations. The API never uses this. ---
DB_OWNER=moneymap_owner
DB_OWNER_PASSWORD=

# --- Runtime role: DML only, no DDL, no BYPASSRLS. This is what the API connects as. ---
DB_APP_USER=moneymap_app
DB_APP_PASSWORD=

# --- Connection strings ---
# The API reads DATABASE_URL. Alembic reads MIGRATION_DATABASE_URL.
DATABASE_URL=postgresql+psycopg://moneymap_app:CHANGE_ME@localhost:5432/moneymap
MIGRATION_DATABASE_URL=postgresql+psycopg://moneymap_owner:CHANGE_ME@localhost:5432/moneymap

# --- Auth ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=60

# --- CORS: comma-separated origins allowed to call the API ---
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
